
@{
    Layout = "_Book";
    var etiketler = ViewBag.GrafikEtiketler as List<string> ?? new List<string>();
    var veriler = ViewBag.GrafikVeriler as List<int> ?? new List<int>();
    var sonKiralamalar = ViewBag.SonKiralamalar as IPagedList<Entites.Models.Rental> ?? new StaticPagedList<Entites.Models.Rental>(new List<Entites.Models.Rental>(), 1, 5, 0);
    var gecikmisList = ViewBag.GecikmisList as List<Entites.Models.Rental> ?? new();
}
<link href="~/lib/bootstrap/dist/css/bootstrap.css" rel="stylesheet" />

<!-- ── ÖZET KARTLAR ── -->
<div class="row mb-4">

    <div class="col-lg-3 col-6">
        <div class="small-box text-bg-primary">
            <div class="inner">
                <h3>@ViewBag.ToplamKitap</h3>
                <p>Toplam Aktif Kitap</p>
            </div>
            <i class="bi bi-book small-box-icon"></i>
            <a asp-controller="Book" asp-action="Index"
               class="small-box-footer link-light link-underline-opacity-0 link-underline-opacity-50-hover">
                Detay <i class="bi bi-link-45deg"></i>
            </a>
        </div>
    </div>

    <div class="col-lg-3 col-6">
        <div class="small-box text-bg-success">
            <div class="inner">
                <h3>@ViewBag.ToplamKullanici</h3>
                <p>Toplam Aktif Üye</p>
            </div>
            <i class="bi bi-people-fill small-box-icon"></i>
            <a asp-controller="User" asp-action="Index"
               class="small-box-footer link-light link-underline-opacity-0 link-underline-opacity-50-hover">
                Detay <i class="bi bi-link-45deg"></i>
            </a>
        </div>
    </div>

    <div class="col-lg-3 col-6">
        <div class="small-box text-bg-warning">
            <div class="inner">
                <h3 style="color:white;">@ViewBag.ToplamKiralama</h3>
                <p style="color:white;">Toplam Kiralama</p>
            </div>
            <i class="bi bi-arrow-left-right small-box-icon" "></i>
            <a asp-controller="RentalEdit" asp-action="Index"
               class="small-box-footer link-underline-opacity-0 link-underline-opacity-50-hover"
               style="color:white;">
                Detay <i class="bi bi-link-45deg"></i>
            </a>
        </div>
    </div>

    <div class="col-lg-3 col-6">
        <div class="small-box text-bg-danger">
            <div class="inner">
                <h3>@ViewBag.GecikmisSayi</h3>
                <p>Gecikmiş Kitap</p>
            </div>
            <i class="bi bi-exclamation-triangle-fill small-box-icon"></i>
            <a asp-controller="RentalOverdue" asp-action="Index"
               class="small-box-footer link-light link-underline-opacity-0 link-underline-opacity-50-hover">
                Detay <i class="bi bi-link-45deg"></i>
            </a>
        </div>
    </div>

</div>

<!-- ── GRAFİK + GECİKMİŞLER ── -->
<div class="row mb-4">

    <!-- Aylık Kiralama Grafiği -->
    <div class="col-lg-7">
        <div class="card shadow-sm">
            <div class="card-header">
                <h5 class="card-title mb-0">
                    <i class="bi bi-bar-chart-fill me-2 text-primary"></i>
                    Aylık Kiralama Sayısı
                </h5>
            </div>
            <div class="card-body">
                <div id="aylikGrafik"></div>
            </div>
        </div>
    </div>

    <!-- Gecikmiş Kitaplar -->
    <div class="col-lg-5">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-danger text-white">
                <h5 class="card-title mb-0">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    Gecikmiş Kitaplar
                </h5>
            </div>
            <div class="card-body p-0">
                @if (gecikmisList.Any())
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var r in gecikmisList)
                        {
                            var gun = (DateTime.Now.Date - r.ReturnDate!.Value.Date).Days;
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="fw-semibold small">@r.User.Name @r.User.Surname</div>
                                    <div class="text-muted" style="font-size:0.8rem;">@r.Book.Title</div>
                                </div>
                                <span class="badge bg-danger rounded-pill">@gun gün</span>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <div class="text-center py-4 text-muted">
                        <i class="bi bi-check-circle fs-3 text-success"></i>
                        <p class="mt-2">Gecikmiş kitap yok</p>
                    </div>
                }
            </div>
        </div>
    </div>

</div>

<!-- ── SON KİRALAMALAR ── -->
<div class="row">
    <div class="col-12">
        <div class="card shadow-sm">
            <div class="card-header">
                <h5 class="card-title mb-0">
                    <i class="bi bi-clock-history me-2 text-secondary"></i>
                    Son Kiralamalar
                </h5>
            </div>
            <div class="card-body p-0">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-center">
                        <tr>
                            <th>Kullanıcı</th>
                            <th>Kitap</th>
                            <th>Kiralama Tarihi</th>
                            <th>Teslim Tarihi</th>
                            <th>Durum</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in sonKiralamalar)
                        {
                            <tr>
                                <td class="fw-semibold">@r.User.Name @r.User.Surname</td>
                                <td>@r.Book.Title</td>
                                <td class="text-center">@r.RentDate.ToString("dd.MM.yyyy")</td>
                                <td class="text-center">@r.ReturnDate?.ToString("dd.MM.yyyy")</td>
                                <td class="text-center">
                                    @if (r.IsReturned)
                                    {
                                        <span class="badge bg-success">Teslim Edildi</span>
                                    }
                                    else if (r.ReturnDate.HasValue && r.ReturnDate.Value.Date < DateTime.Now.Date)
                                    {
                                        <span class="badge bg-danger">Gecikmiş</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Kirada</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <div class="mt-3 d-flex justify-content-center">
                    @Html.PagedListPager(sonKiralamalar, page => Url.Action("Index", new { pageNo = page }),
                    new PagedListRenderOptions
                    {
                        LiElementClasses = new[] { "page-item" },
                        PageClasses = new[] { "page-link" }
                    })
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ApexCharts -->
<script src="https://cdn.jsdelivr.net/npm/apexcharts@3.37.1/dist/apexcharts.min.js"
        crossorigin="anonymous"></script>

<script>
    var etiketler = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(etiketler));
    var veriler   = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(veriler));

    var options = {
        series: [{ name: 'Kiralama Sayısı', data: veriler }],
        chart: { type: 'bar', height: 280, toolbar: { show: false } },
        colors: ['#0d6efd'],
        plotOptions: { bar: { borderRadius: 4, columnWidth: '50%' } },
        dataLabels: { enabled: false },
        xaxis: { categories: etiketler },
        yaxis: { title: { text: 'Adet' }, min: 0 },
        grid: { borderColor: '#f1f1f1' }
    };

    new ApexCharts(document.querySelector('#aylikGrafik'), options).render();
</script>
