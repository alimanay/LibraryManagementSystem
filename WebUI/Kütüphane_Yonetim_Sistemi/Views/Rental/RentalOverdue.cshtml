@model X.PagedList.IPagedList<Entites.Models.Rental>
@using X.PagedList.Mvc.Core
@using X.PagedList
@{
    Layout = "_Book";
}
<link href="~/css/RentalDetail.css" rel="stylesheet" />

<!-- Breadcrumb -->
<nav aria-label="breadcrumb" class="mb-2">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Index">Ana Sayfa</a></li>
        <li class="breadcrumb-item"><a asp-controller="RentalEdit" asp-action="Index">Kiralama Listesi</a></li>
        <li class="breadcrumb-item active">Gecikmiş Kayıtlar</li>
    </ol>
</nav>

<!-- Header -->
<div class="d-flex align-items-center mb-3">
    <div>
        <h4 class="fw-bold mb-0"><i class="bi bi-exclamation-triangle text-danger me-2"></i>Gecikmiş Kayıtlar</h4>
        <small class="text-muted">Toplam <strong>@Model.TotalItemCount</strong> gecikmiş kayıt</small>
    </div>
</div>

<!-- Tablo -->
<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Üye</th>
                    <th>Kitap</th>
                    <th>Yazar</th>
                    <th class="text-center">Kiralama</th>
                    <th class="text-center">Son Teslim</th>
                    <th style="width:110px" class="text-center">Gecikme</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        var gecikmeGun = item.ReturnDate.HasValue
                            ? (DateTime.Now.Date - item.ReturnDate.Value.Date).Days
                            : 0;
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="user-avatar" style="background: linear-gradient(135deg, #ef4444, #f87171);">
                                        @item.User.Name.Substring(0, 1).ToUpper()
                                    </div>
                                    <span class="fw-semibold">@item.User.Name @item.User.Surname</span>
                                </div>
                            </td>
                            <td class="text-muted" style="max-width:220px;">@item.Book.Title</td>
                            <td class="text-muted small">@item.Book.Author</td>
                            <td class="text-center small">@item.RentDate.ToString("dd.MM.yyyy")</td>
                            <td class="text-center small text-danger fw-semibold">
                                @item.ReturnDate?.ToString("dd.MM.yyyy")
                            </td>
                            <td class="text-center">
                                <span class="status-badge overdue">@gecikmeGun gün</span>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted">
                            ✅ Gecikmiş kayıt bulunamadı
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="py-3 d-flex justify-content-center">
            @Html.PagedListPager(Model, page => Url.Action("Index", new { pageNo = page }),
                new PagedListRenderOptions
                {
                    LiElementClasses = new[] { "page-item" },
                    PageClasses = new[] { "page-link" }
                })
        </div>
    </div>
</div>
