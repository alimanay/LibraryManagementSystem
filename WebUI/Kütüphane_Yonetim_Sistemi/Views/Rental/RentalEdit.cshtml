@model List<Entites.Models.Rental>
@using X.PagedList.Mvc.Core
@using X.PagedList
@{
    Layout = "_Book";
}
<link href="~/lib/bootstrap/dist/css/bootstrap.css" rel="stylesheet" />

<table class="table table-bordered table-hover align-middle mb-0">
    <thead class="table-light text-center">
        <tr>
            <th>Adı Soyadı</th>
            <th>Kitap Adı</th>
            <th>Yazarı</th>
            <th>Kiralanma Tarihi</th>
            <th>Teslim Tarihi</th>
            <th style="width:120px">Durum</th>
            <th style="width:180px">İşlemler</th>
        </tr>
    </thead>

    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var user in Model)
            {
                <tr>
                    <td class="fw-semibold">
                        @user.User.Name  @user.User.Surname
                    </td>

                    <td style="max-width:300px;">
                        @user.Book.Title
                    </td>

                    <td style="max-width:300px;">
                        @user.Book.Author
                    </td>

                    <td>
                        @user.RentDate.ToString("dd.MM.yyyy")


                    </td>
                    <td>
                        @user.ReturnDate?.ToString("dd.MM.yyyy")

                    </td>
                    

                    <td class="text-center">
                        @if (user.IsReturned)
                        {
                            <span class="badge bg-success">Aktif</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Kirada</span>
                        }
                    </td>

                    <!-- İŞLEMLER -->
                    <td class="text-center">

                        <a asp-controller="User"
                           asp-action="EditUser"
                           asp-route-id="@user.UserId"
                           class="btn btn-warning btn-sm me-1">
                            ✏️ Düzenle
                        </a>

                        <form asp-controller="User"
                              asp-action="DeleteUser"
                              asp-route-id="@user.UserId"
                              method="post"
                              class="d-inline"
                              onsubmit="return confirm('@user.User.Name @user.User.Surname kullanıcısını silmek istiyor musunuz?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-danger btn-sm">
                                🗑️ Sil
                            </button> 
                         </form> 

                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="5" class="text-center py-4 text-muted">
                    📭 Kayıtlı kullanıcı bulunamadı
                </td>
            </tr>
        }
    </tbody>

</table>
