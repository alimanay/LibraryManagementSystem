@model Entites.Dtos.BookDtos.BookUpdateDto
@{
    Layout = "_Book";
}
<link href="~/css/EditBook.css" rel="stylesheet" />

<!-- Breadcrumb -->
<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Index">Ana Sayfa</a></li>
        <li class="breadcrumb-item"><a asp-controller="Book" asp-action="Index">Kitap Yönetimi</a></li>
        <li class="breadcrumb-item active">Kitap Güncelle</li>
    </ol>
</nav>

<!-- Header -->
<div class="d-flex align-items-center mb-3">
    <h4 class="fw-bold mb-0"><i class="bi bi-pencil-square text-primary me-2"></i>Kitap Güncelle</h4>
</div>

<!-- Form Card -->
<div class="card shadow-sm border-0">
    <div class="card-body p-4">
        <form asp-action="UpdateBook" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />

            <div class="row g-3">

                <div class="col-md-6">
                    <label class="form-label fw-semibold">Kitap Adı</label>
                    <input asp-for="Title" class="form-control" placeholder="Kitap adını girin..." />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold">Yazar</label>
                    <input asp-for="Author" class="form-control" placeholder="Yazar adını girin..." />
                    <span asp-validation-for="Author" class="text-danger small"></span>
                </div>

                <div class="col-12">
                    <label class="form-label fw-semibold">Açıklama</label>
                    <textarea asp-for="Description" rows="4" class="form-control"
                              placeholder="Kitap hakkında kısa bir açıklama..."></textarea>
                </div>

                <div class="col-12">
                    <div class="form-check form-switch">
                        <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                        <label class="form-check-label fw-semibold">Aktif</label>
                    </div>
                </div>

            </div>

            <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                <a asp-controller="Book" asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-x-lg me-1"></i>Vazgeç
                </a>
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-lg me-1"></i>Güncelle
                </button>
            </div>

        </form>
    </div>
</div>
