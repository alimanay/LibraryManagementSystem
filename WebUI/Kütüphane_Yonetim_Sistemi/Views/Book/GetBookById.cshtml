@model Entites.Dtos.BookDtos.BookUpdateDto

@{
    Layout = "_Book";
}
<link href="~/lib/bootstrap/dist/css/bootstrap.css" rel="stylesheet" />
<link href="~/css/EditBook.css" rel="stylesheet" />


<div class="container-fluid px-4 mt-4">

    <div class="card shadow-sm border-0 update-card">

        <div class="card-header bg-white border-bottom">
            <h4 class="mb-0 fw-semibold text-dark">
                📘 Kitap Güncelle
            </h4>
        </div>

        <div class="card-body">

            <form asp-action="UpdateBook" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />

                <div class="row">

                    <!-- Title -->
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Kitap Adı</label>
                        <input asp-for="Title" class="form-control modern-input" />
                    </div>
                    <br />

                    <!-- Author -->
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Yazar</label>
                        <input asp-for="Author" class="form-control modern-input" />
                    </div>

                    <!-- IsActive -->
                    <div class="mb-2 d-flex align-items-end">
                        <div class="form-check form-switch">
                            <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                            <label class="form-check-label fw-semibold">
                                Aktif mi?
                            </label>
                        </div>
                    </div>

                    <!-- Description -->
                    <div class="col-12 mb-3">
                        <label class="form-label">Açıklama</label>
                        <textarea asp-for="Description" rows="4"
                                  class="form-control modern-input"></textarea>
                    </div>

                </div>
                <div class="d-flex justify-content-end mt-4 pt-3 border-top action-buttons">

                    <a asp-controller="Book"
                       asp-action="Index"
                       class="btn btn-light">
                        Vazgeç
                    </a>

                    <button type="submit"
                            class="btn btn-primary">
                        Güncelle
                    </button>

                </div>

            </form>

        </div>
    </div>

</div>