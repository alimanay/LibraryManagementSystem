@model X.PagedList.IPagedList<Entites.Models.Book>
@using X.PagedList.Mvc.Core
@using X.PagedList
@{
    Layout = "_Book";
}
<link href="~/lib/bootstrap/dist/css/bootstrap.css" rel="stylesheet" />

<div class="container-fluid px-4 mt-4">

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

 
    <div class="card mb-4 shadow-sm">
        <div class="card-body">
            <div class="row align-items-center">
                <div class="col-md-6">
                    <h3 class="fw-bold mb-0">Kitap Yönetimi</h3>
                    <small class="text-muted">Kitap ekle, sil ve yönet</small>
                </div>
                <div class="col-md-6 text-end">
                    <form asp-action="CreateBook" method="post" class="d-inline-flex">
                        <input type="text"
                               name="query"
                               class="form-control me-2"
                               placeholder="ISBN veya Kitap İsmi Giriniz"
                               required />
                        <button class="btn btn-dark">Ekle</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Tablo -->
    <div class="card shadow-sm">
        <div class="card-body p-0">
            <table class="table table-bordered table-hover align-middle mb-0">
                <thead class="table-secondary text-center">
                    <tr>
                        <th style="width:100px">Kapak</th>
                        <th>Kitap Adı</th>
                        <th>Açıklama</th>
                        <th>Yazar</th>
                        <th style="width:110px">Durum</th>
                        <th style="width:180px">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var book in Model)
                        {
                            <tr>
                                <td class="text-center">
                                    <img src="@book.Image" class="img-fluid rounded" style="max-height:80px" />
                                </td>
                                <td class="fw-semibold">@book.Title</td>
                                <td style="max-width:320px" class="text-muted">
                                    @(string.IsNullOrWhiteSpace(book.Description)
                                                                ? "Açıklama yok"
                                                                : book.Description.Length > 100
                                                                ? book.Description.Substring(0, 100) + "..."
                                                                : book.Description)
                                </td>
                                <td>@book.Author</td>
                                <td class="text-center">
                                    @if (book.IsActive)
                                    {
                                        <span class="badge bg-success">Var</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Yok</span>
                                    }
                                </td>
                                <td class="text-center" style="white-space:nowrap;">
                                    <div class="d-flex justify-content-center gap-1">

                                        <a asp-controller="EditBook"
                                           asp-action="GetBookById"
                                           asp-route-id="@book.Id"
                                           class="btn btn-sm"
                                           style="background-color:#6f42c1; color:white; border:none;">
                                            ✏️ Güncelle
                                        </a>

                                        <button type="button"
                                                class="btn btn-sm btn-danger"
                                                onclick="openDeleteModal(@book.Id, '@book.Title')">
                                            🗑️ Sil
                                        </button>

                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                📭 Kayıtlı kitap bulunamadı
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="mt-3 d-flex justify-content-center">
                @Html.PagedListPager(Model, page => Url.Action("Index", new { pageNo = page }),
                new PagedListRenderOptions
                {
                    LiElementClasses = new[] { "page-item" },
                    PageClasses = new[] { "page-link" }
                })
            </div>
        </div>
    </div>
</div>

<!-- SİL MODAL -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">🗑️ Kitabı Sil</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="mb-3"><strong>Kitap:</strong> <span id="deleteBookTitle"></span></p>
                <p class="text-danger mb-0">⚠️ Bu işlem geri alınamaz. Silmek istiyor musunuz?</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Vazgeç</button>
                <form id="deleteForm" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">🗑️ Evet, Sil</button>
                </form>
            </div>
        </div>
    </div>
</div>
<script src="~/js/Book.js"></script>