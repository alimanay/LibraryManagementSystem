@{
    var currentController = ViewContext.RouteData.Values["Controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["Action"]?.ToString();
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Kütüphane Yönetim Paneli</title>
    <!-- Modern bir görünüm için Bootstrap CSS -->
    <link href="[https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css](https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css)" rel="stylesheet">
    <link href="~/css/Book.css" rel="stylesheet" />
</head>
<body>

    <!-- SOL MENÜ (SIDEBAR) -->
    <div class="sidebar">

        <h4 class="head-h4">Kütüphane Admin</h4>
        <hr>
        <a asp-controller="Home" asp-action="Index"
           class="@(currentController == "Home" ? "active" : "")">
            Dashboard
        </a>
        <a asp-controller="Book" asp-action="Index"
           class="@(currentController == "Book" ? "active" : "")">
            Kitap Yönetimi
        </a>
        <a asp-controller="User" asp-action="Index"
           class="@(currentController == "User" ? "active" : "")">
            Üye İşlemleri
        </a>
         <div class="nav-item dropdown">
            <a class="d-block p-2 text-green
               text-decoration-none dropdown-toggle"
               href="#"
               id="rentalDropdown"
               role="button"
               data-bs-toggle="dropdown"
               aria-expanded="false" >
                Ödünç Kayıtları
            </a>
            <ul class="dropdown-menu text-dark " style="background-color:#2c3e50" aria-labelledby="rentalDropdown">
                <li>
                    <a class="dropdown-item  @(currentController == "Rental" ? "active" : "")" asp-controller="Rental" asp-action="Index">Kitap Kiralama</a>
                </li>
                <li>
                    <a class="dropdown-item   @(currentController == "RentalEdit" ? "active" : "")" asp-controller="RentalEdit" asp-action="Index">Kitap Kiralama Düzenleme</a>
                </li>
                <li>
                    <a class="dropdown-item @(currentController == "ReturnedRental" ? "active" : "")" asp-controller="ReturnedRental" asp-action="Index">Teslim Edilenler</a>
                </li>
                <li>
                    <a class="dropdown-item @(currentController == "RentalOverdue" ? "active" : "") " asp-controller="RentalOverdue" asp-action="Index">Gecikmiş Kayıtlar</a>
                </li>
            </ul>
        </div>
       
    </div>

    <div class="main-content">
        <!-- ÜST BAR -->
        <header>
            <span class="text-muted">Hoş Geldiniz, @Context.Session.GetString("Admin")</span>
            @Html.AntiForgeryToken()
            <form asp-controller="Account"
                  asp-action="Logout"
                  method="post"
                  class="d-inline">

                @Html.AntiForgeryToken()

                <button type="submit" class="btn btn-outline-danger btn-sm">
                    Çıkış Yap
                </button>
            </form>
        </header>

        <!-- DEĞİŞKEN İÇERİK (SAYFA İÇERİĞİ) -->
        <div class="container-fluid">
            @RenderBody()
        </div>

        <footer>
            &copy; 2024 - Kütüphane Yönetim Sistemi - Tüm Hakları Saklıdır.
        </footer>
    </div>

    <link href="~/Content/PagedList.css" rel="stylesheet" />
    <script src="~/Scripts/jquery-1.10.2.min.js"></script>
    <script src="~/Scripts/jquery.unobtrusive-ajax.min.js"></script>
    <script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/Scripts/jquery.validate.min.js"></script>
     <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

<!-- scriptleri body kapanışından hemen önce ekleyin -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.4/jquery.min.js" integrity="" crossorigin="anonymous"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js" integrity="" crossorigin="anonymous"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js" integrity="" crossorigin="anonymous"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-unobtrusive-ajax/3.2.6/jquery.unobtrusive-ajax.min.js" integrity="" crossorigin="anonymous"></script>
