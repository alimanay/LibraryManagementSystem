@{
    var currentController = ViewContext.RouteData.Values["Controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["Action"]?.ToString();

    var rentalControllers = new[] { "Rental", "RentalEdit", "ReturnedRental", "RentalOverdue" };
    var rentalActive = rentalControllers.Contains(currentController) ? "menu-open" : "";
    var rentalShow = rentalControllers.Contains(currentController) ? "show" : "";
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes" />
    <meta name="color-scheme" content="light dark" />
    <title>Kütüphane Yönetim Paneli</title>

    <!-- Fonts -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/@@fontsource/source-sans-3@5.0.12/index.css"
          crossorigin="anonymous" />

    <!-- OverlayScrollbars -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/overlayscrollbars@2.11.0/styles/overlayscrollbars.min.css"
          crossorigin="anonymous" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css"
          crossorigin="anonymous" />

    <!-- AdminLTE 4 CSS -->
    <link rel="stylesheet" href="~/css/adminlte.min.css" />

    <!-- Özel CSS -->
    <link rel="stylesheet" href="~/css/Book.css" />
</head>

<body class="layout-fixed sidebar-expand-lg bg-body-tertiary">
    <div class="app-wrapper">

        <!-- ── NAVBAR ── -->
        <nav class="app-header navbar navbar-expand bg-body">
            <div class="container-fluid">

                <!-- Sol: sidebar toggle -->
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="nav-link" data-lte-toggle="sidebar" href="#" role="button">
                            <i class="bi bi-list"></i>
                        </a>
                    </li>
                </ul>

                <!-- Sağ: hoş geldiniz + çıkış -->
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item d-flex align-items-center me-3">
                        <span class="text-muted small">
                            Hoş Geldiniz, <strong>@Context.Session.GetString("Admin")</strong>
                        </span>
                    </li>
                    <li class="nav-item">
                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-danger btn-sm">
                                <i class="bi bi-box-arrow-right me-1"></i> Çıkış Yap
                            </button>
                        </form>
                    </li>
                </ul>

            </div>
        </nav>

        <!-- ── SIDEBAR ── -->
        <aside class="app-sidebar bg-body-secondary shadow" data-bs-theme="dark">

            <!-- Logo -->
            <div class="sidebar-brand">
                <a asp-action="Index" asp-controller="Dashboard" class="brand-link">
                    <i class="bi bi-book-half brand-image opacity-75"
                       style="font-size:1.6rem; margin-right:8px;"></i>
                    <span class="brand-text fw-bold">Kütüphane Admin</span>
                </a>
            </div>

            <!-- Menü -->
            <div class="sidebar-wrapper">
                <nav class="mt-2">
                    <ul class="nav sidebar-menu flex-column"
                        data-lte-toggle="treeview"
                        role="navigation"
                        data-accordion="false">

                        <!-- Dashboard -->
                        <li class="nav-item">
                            <a asp-controller="Dashboard" asp-action="Index"
                               class="nav-link @(currentController == "Dashboard" ? "active" : "")">
                                <i class="nav-icon bi bi-speedometer2"></i>
                                <p>Dashboard</p>
                            </a>
                        </li>

                        <!-- Kitap Yönetimi -->
                        <li class="nav-item">
                            <a asp-controller="Book" asp-action="Index"
                               class="nav-link @(currentController == "Book" ? "active" : "")">
                                <i class="nav-icon bi bi-book"></i>
                                <p>Kitap Yönetimi</p>
                            </a>
                        </li>

                        <!-- Üye İşlemleri -->
                        <li class="nav-item">
                            <a asp-controller="User" asp-action="Index"
                               class="nav-link @(currentController == "User" ? "active" : "")">
                                <i class="nav-icon bi bi-people-fill"></i>
                                <p>Üye İşlemleri</p>
                            </a>
                        </li>

                        <!-- Ödünç Kayıtları (Dropdown) -->
                        <li class="nav-item @rentalActive">
                            <a href="#" class="nav-link @(rentalActive != "" ? "active" : "")">
                                <i class="nav-icon bi bi-arrow-left-right"></i>
                                <p>
                                    Ödünç Kayıtları
                                    <i class="nav-arrow bi bi-chevron-right"></i>
                                </p>
                            </a>
                            <ul class="nav nav-treeview @rentalShow">
                                <li class="nav-item">
                                    <a asp-controller="Rental" asp-action="Index"
                                       class="nav-link @(currentController == "Rental" ? "active" : "")">
                                        <i class="nav-icon bi bi-circle"></i>
                                        <p>Kitap Kiralama</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a asp-controller="RentalEdit" asp-action="Index"
                                       class="nav-link @(currentController == "RentalEdit" ? "active" : "")">
                                        <i class="nav-icon bi bi-circle"></i>
                                        <p>Kiralama Düzenleme</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a asp-controller="ReturnedRental" asp-action="Index"
                                       class="nav-link @(currentController == "ReturnedRental" ? "active" : "")">
                                        <i class="nav-icon bi bi-circle"></i>
                                        <p>Teslim Edilenler</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a asp-controller="RentalOverdue" asp-action="Index"
                                       class="nav-link @(currentController == "RentalOverdue" ? "active" : "")">
                                        <i class="nav-icon bi bi-circle"></i>
                                        <p>Gecikmiş Kayıtlar</p>
                                    </a>
                                </li>
                            </ul>
                        </li>

                    </ul>
                </nav>
            </div>

        </aside>

        <!-- ── SAYFA İÇERİĞİ ── -->
        <main class="app-main">
            <div class="app-content">
                <div class="container-fluid py-3">
                    @RenderBody()
                </div>
            </div>
        </main>

        <!-- ── FOOTER ── -->
        <footer class="app-footer text-center text-muted small">
            &copy; 2026 - Kütüphane Yönetim Sistemi - Tüm Hakları Saklıdır.
        </footer>

    </div>
    <!-- /.app-wrapper -->
    <!-- OverlayScrollbars -->
    <script src="https://cdn.jsdelivr.net/npm/overlayscrollbars@2.11.0/browser/overlayscrollbars.browser.es6.min.js"
            crossorigin="anonymous"></script>
    <!-- Popper -->
    <script src="https://cdn.jsdelivr.net/npm/@@popperjs/core@2.11.8/dist/umd/popper.min.js"
            crossorigin="anonymous"></script>
    <!-- Bootstrap -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.min.js"
            crossorigin="anonymous"></script>
    <!-- AdminLTE 4 JS -->
    <script src="~/js/adminlte.js"></script>

    <!-- OverlayScrollbars config -->
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const sidebarWrapper = document.querySelector('.sidebar-wrapper');
            const isMobile = window.innerWidth <= 992;
            if (sidebarWrapper && typeof OverlayScrollbarsGlobal !== 'undefined' && !isMobile) {
                OverlayScrollbarsGlobal.OverlayScrollbars(sidebarWrapper, {
                    scrollbars: { theme: 'os-theme-light', autoHide: 'leave', clickScroll: true }
                });
            }
        });
    </script>

    <!-- jQuery (AJAX için) -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.4/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-unobtrusive-ajax/3.2.6/jquery.unobtrusive-ajax.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
