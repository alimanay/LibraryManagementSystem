
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Kütüphane Yönetim Paneli</title>
    <!-- Modern bir görünüm için Bootstrap CSS -->
    <link href="[https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css](https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css)" rel="stylesheet">
    <link href="~/css/Book.css" rel="stylesheet" />
</head>
<body>
    <!-- SOL MENÜ (SIDEBAR) -->
    <div class="sidebar">
        <h4 class="head-h4">Kütüphane Admin</h4>
        <hr>
        <a href="/Home/Index">Dashboard</a>
        <a asp-controller="Book" asp-action="Index" >Kitap Yönetimi</a>
        <a  asp-controller="User" asp-action="GetUsers">Üye İşlemleri</a>
        <a href="/Loan/Index">Ödünç Kayıtları</a>
    </div>

    <div class="main-content">
        <!-- ÜST BAR -->
        <header>
            <span class="text-muted">Hoş Geldiniz, @Context.Session.GetString("Admin")</span>
            @Html.AntiForgeryToken()
            <form asp-controller="Account"
                  asp-action="Logout"
                  method="post"
                  class="d-inline">

                @Html.AntiForgeryToken()

                <button type="submit" class="btn btn-outline-danger btn-sm">
                    Çıkış Yap
                </button>
            </form>
        </header>

        <!-- DEĞİŞKEN İÇERİK (SAYFA İÇERİĞİ) -->
        <div class="container-fluid">
            @RenderBody()
        </div>

        <footer>
            &copy; 2024 - Kütüphane Yönetim Sistemi - Tüm Hakları Saklıdır.
        </footer>
    </div>
</body>
</html>

