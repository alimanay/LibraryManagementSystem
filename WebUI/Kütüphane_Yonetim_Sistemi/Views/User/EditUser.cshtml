@model Entites.Dtos.UserDtos.UpdateUserDto

@{
    Layout = "_Book";
}
<link href="~/lib/bootstrap/dist/css/bootstrap.css" rel="stylesheet" />
<link href="~/css/EditBook.css" rel="stylesheet" />

<div class="container-fluid px-4 mt-4">
    <div class="card shadow-sm border-0 update-card">
        <div class="card-header bg-white border-bottom">
            <h4 class="mb-0 fw-semibold text-dark">👤 Kullanıcı Güncelle</h4>
        </div>

        <div class="card-body">
            @* ModelState hatalarını göster *@
            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <form asp-controller="User" asp-action="UpdateUser" method="post" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="UserId" />

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Name" class="form-label">Ad</label>
                        <input asp-for="Name" class="form-control modern-input" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Surname" class="form-label">Soyad</label>
                        <input asp-for="Surname" class="form-control modern-input" />
                        <span asp-validation-for="Surname" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Email" class="form-label">E-posta</label>
                        <input asp-for="Email" type="email" class="form-control modern-input" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="PhoneNumber" class="form-label">Telefon</label>
                        <input asp-for="PhoneNumber" class="form-control modern-input" />
                        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                    </div>

                    <div class="mb-2 d-flex align-items-center">
                        <div class="form-check form-switch">
                            <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                            <label class="form-check-label fw-semibold" for="IsActive">Aktif mi?</label>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-end mt-4 pt-3 border-top action-buttons">
                    <a asp-controller="User" asp-action="GetUsers" class="btn btn-light me-2">Vazgeç</a>
                    <button type="submit" class="btn btn-primary">Güncelle</button>
                </div>
            </form>
        </div>
    </div>
</div>

