@model Entites.Dtos.UserDtos.UpdateUserDto
@{
    Layout = "_Book";
}
<link href="~/css/UserIndex.css" rel="stylesheet" />

<!-- Breadcrumb -->
<nav aria-label="breadcrumb" class="mb-2">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Ana Sayfa</a></li>
        <li class="breadcrumb-item"><a asp-controller="User" asp-action="Index">Üye İşlemleri</a></li>
        <li class="breadcrumb-item active">Kullanıcı Güncelle</li>
    </ol>
</nav>

<!-- Header -->
<div class="d-flex align-items-center mb-3">
    <h4 class="fw-bold mb-0"><i class="bi bi-person-gear text-primary me-2"></i>Kullanıcı Güncelle</h4>
</div>

<!-- Form Card -->
<div class="card shadow-sm border-0">
    <div class="card-body p-4">
        <form asp-controller="User" asp-action="UpdateUser" method="post" novalidate>
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="UserId" />

            <div class="row g-3">

                <div class="col-md-6">
                    <label asp-for="Name" class="form-label fw-semibold">Ad</label>
                    <input asp-for="Name" class="form-control" placeholder="Adını girin..." />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Surname" class="form-label fw-semibold">Soyad</label>
                    <input asp-for="Surname" class="form-control" placeholder="Soyadını girin..." />
                    <span asp-validation-for="Surname" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="TCNumber" class="form-label fw-semibold">TC Kimlik No</label>
                    <input asp-for="TCNumber" class="form-control" type="tel" placeholder="11 haneli TC kimlik..." />
                    <span asp-validation-for="TCNumber" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Email" class="form-label fw-semibold">E-posta</label>
                    <input asp-for="Email" type="email" class="form-control" placeholder="ornek@email.com" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="PhoneNumber" class="form-label fw-semibold">Telefon</label>
                    <input asp-for="PhoneNumber" class="form-control" type="tel" placeholder="05xxxxxxxxx" />
                    <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                </div>

                <div class="col-12">
                    <div class="form-check form-switch">
                        <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                        <label class="form-check-label fw-semibold">Aktif</label>
                    </div>
                </div>

            </div>

            <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                <a asp-controller="User" asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-x-lg me-1"></i>Vazgeç
                </a>
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-lg me-1"></i>Güncelle
                </button>
            </div>

        </form>
    </div>
</div>
