@model X.PagedList.IPagedList<Entites.Models.User>
@using X.PagedList.Mvc.Core
@using X.PagedList
@{
    Layout = "_Book";
}
<link href="~/css/UserIndex.css" rel="stylesheet" />

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-3" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-3" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Breadcrumb -->
<nav aria-label="breadcrumb" class="mb-2">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Index">Ana Sayfa</a></li>
        <li class="breadcrumb-item active">Üye İşlemleri</li>
    </ol>
</nav>

<!-- Header -->
<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h4 class="fw-bold mb-0"><i class="bi bi-people text-primary me-2"></i>Üye İşlemleri</h4>
        <small class="text-muted">Toplam <strong>@Model.TotalItemCount</strong> üye</small>
    </div>
    <a asp-controller="User" asp-action="CreateUser" class="btn btn-primary btn-sm">
        <i class="bi bi-person-plus me-1"></i> Kullanıcı Oluştur
    </a>
</div>

<!-- Tablo -->
<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Adı Soyadı</th>
                    <th>Email</th>
                    <th>Telefon</th>
                    <th style="width:100px" class="text-center">Durum</th>
                    <th style="width:180px" class="text-center">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var user in Model)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="user-avatar">
                                        @user.Name.Substring(0, 1).ToUpper()
                                    </div>
                                    <span class="fw-semibold">@user.Name @user.Surname</span>
                                </div>
                            </td>
                            <td class="text-muted">@user.Email</td>
                            <td class="text-muted">@user.PhoneNumber</td>
                            <td class="text-center">
                                @if (user.IsActive)
                                {
                                    <span class="badge bg-success">Aktif</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Pasif</span>
                                }
                            </td>
                            <td class="text-center" style="white-space:nowrap;">
                                <div class="d-flex justify-content-center gap-1">
                                    <a asp-controller="User"
                                           asp-action="EditUser"
                                           asp-route-id="@user.UserId"
                                           class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-pencil"></i> Düzenle
                                    </a>
                                    <button type="button"
                                            class="btn btn-sm btn-outline-danger"
                                            onclick="openDeleteModal(@user.UserId, '@user.Name @user.Surname')">
                                        <i class="bi bi-trash"></i> Sil
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center py-5 text-muted">
                            📭 Kayıtlı kullanıcı bulunamadı
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="py-3 d-flex justify-content-center">
            @Html.PagedListPager(Model, page => Url.Action("Index", new { pageNo = page }),
                new PagedListRenderOptions
                {
                    LiElementClasses = new[] { "page-item" },
                    PageClasses = new[] { "page-link" }
                })
        </div>
    </div>
</div>

<!-- SİL MODAL -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width:420px;">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-danger text-white">
                <h6 class="modal-title"><i class="bi bi-trash me-2"></i>Kullanıcıyı Sil</h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="mb-1">Şu kullanıcıyı silmek istediğinizden emin misiniz?</p>
                <p class="fw-semibold" id="deleteUserName"></p>
                <p class="text-danger small mb-0">⚠️ Bu işlem geri alınamaz.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Vazgeç</button>
                <form id="deleteForm" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger btn-sm">Evet, Sil</button>
                </form>
            </div>
        </div>
    </div>
</div>

<script src="~/js/User.js"></script>
