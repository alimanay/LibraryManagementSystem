@{
    Layout = "_User";
    var kiralamalar = ViewBag.Kiralamalar as List<Entites.Models.Rental> ?? new();
}
<link href="~/css/RentalDetail.css" rel="stylesheet" />

<!-- Breadcrumb -->
<nav aria-label="breadcrumb" class="mb-2">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="UserDashboard" asp-action="GetUserDashboard">Panelim</a></li>
        <li class="breadcrumb-item active">Kiralamalarım</li>
    </ol>
</nav>

<!-- Header -->
<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h4 class="fw-bold mb-0"><i class="bi bi-book text-primary me-2"></i>Kiralamalarım</h4>
        <small class="text-muted">Aktif olarak kirada olan kitaplarınız</small>
    </div>
    <span class="badge bg-primary fs-6">@kiralamalar.Count kitap</span>
</div>

<!-- Tablo -->
<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Kitap</th>
                    <th>Yazar</th>
                    <th class="text-center">Kiralama Tarihi</th>
                    <th class="text-center">Son Teslim</th>
                    <th class="text-center" style="width:130px">Durum</th>
                </tr>
            </thead>
            <tbody>
                @if (kiralamalar.Any())
                {
                    foreach (var r in kiralamalar.OrderBy(x => x.ReturnDate))
                    {
                        var kalanGun = r.ReturnDate.HasValue
                            ? (r.ReturnDate.Value.Date - DateTime.Now.Date).Days
                            : 0;
                        var rowClass = kalanGun < 0 ? "table-danger" : kalanGun <= 3 ? "table-warning" : "";

                        <tr class="@rowClass">
                            <td class="fw-semibold">@r.Book?.Title</td>
                            <td class="text-muted small">@r.Book?.Author</td>
                            <td class="text-center small">@r.RentDate.ToString("dd.MM.yyyy")</td>
                            <td class="text-center small fw-semibold @(kalanGun < 0 ? "text-danger" : "")">
                                @r.ReturnDate?.ToString("dd.MM.yyyy")
                            </td>
                            <td class="text-center">
                                @if (kalanGun < 0)
                                {
                                    <span class="status-badge overdue">@(kalanGun * -1) gün geç</span>
                                }
                                else if (kalanGun <= 3)
                                {
                                    <span class="status-badge" style="background:#fff3cd; color:#856404;">⚠️ @kalanGun gün kaldı</span>
                                }
                                else
                                {
                                    <span class="status-badge rented">@kalanGun gün kaldı</span>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center py-5 text-muted">
                            📭 Aktif kiralamanız bulunmuyor
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
