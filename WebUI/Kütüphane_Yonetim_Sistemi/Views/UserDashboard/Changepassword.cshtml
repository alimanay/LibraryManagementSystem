@{
    Layout = "_LoginLayout";
}
<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
<div class="login-card">

    <!-- İkon -->
    <div class="text-center mb-3 mt-5">
        <div style="width:56px; height:56px; background:linear-gradient(135deg,#0d6efd,#6ea8fe);
            border-radius:50%; display:flex; align-items:center; justify-content:center;
            margin:0 auto; font-size:1.4rem; color:white;">
            🔐
        </div>
    </div>

    <h4 class="fw-bold text-center mb-1">Şifreni Değiştir</h4>
    <p class="text-muted text-center small mb-4">
        Güvenliğin için lütfen yeni bir şifre belirle
    </p>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger small py-2 rounded-3" style="max-width:380px; margin:0 auto;">
            <i class="bi bi-exclamation-triangle me-1"></i>@ViewBag.Error
        </div>
    }

    <form asp-controller="UserDashboard" asp-action="ChangePassword" method="post">
        @Html.AntiForgeryToken()

        <div class="login-card" style="max-width:380px; margin:0 auto;">

            <div class="mb-3">
                <label class="form-label fw-semibold small">Yeni Şifre</label>
                <input type="password" name="newPassword" class="form-control"
                       placeholder="Yeni şifrenizi girin" required
                       style="border-radius:10px; padding:6px 12px;" />
            </div>

            <div class="mb-4">
                <label class="form-label fw-semibold small">Şifre Tekrar</label>
                <input type="password" name="confirmPassword" class="form-control"
                       placeholder="Şifrenizi tekrar girin" required
                       style="border-radius:10px; padding:6px 12px;" />
            </div>

            <button type="submit" class="btn btn-primary w-100 fw-semibold"
                    style="border-radius:10px; padding:8px;">
                Şifremi Güncelle
            </button>

        </div>
    </form>

    <div class="text-center mt-3">
        <small class="text-muted">
            <i class="bi bi-shield-check me-1 text-success"></i>
            Şifren güvenli şekilde şifrelenerek saklanır
        </small>
    </div>

</div>
