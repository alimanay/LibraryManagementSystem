@{
    Layout = "_LoginLayout";
}
<link href="~/css/LoginPanel.css" rel="stylesheet" />

<div class="login-wrapper" style="max-width:480px; min-height:auto; margin:0 auto;">
    <div class="login-right" style="flex:1; padding:48px 44px;">
        <div class="login-form-box" style="max-width:100%;">

            <div class="text-center mb-4">
                <div style="width:52px; height:52px; background:linear-gradient(135deg,#3b82f6,#6366f1);
                    border-radius:50%; display:flex; align-items:center; justify-content:center;
                    margin:0 auto 16px; font-size:1.3rem;">
                    🔑
                </div>
                <h3 class="login-heading">Şifremi Unuttum</h3>
                <p class="login-sub">Email adresinizi girin, sıfırlama linki gönderelim</p>
            </div>

            @if (ViewBag.Error != null)
            {
                <div class="login-error"><span>⚠️</span> @ViewBag.Error</div>
            }
            @if (ViewBag.Success != null)
            {
                <div style="background:#f0fdf4; border:1px solid #bbf7d0; color:#16a34a;
                    border-radius:10px; padding:10px 14px; font-size:0.85rem; margin-bottom:20px;">
                    ✅ @ViewBag.Success
                </div>
            }

            <form method="post" asp-action="ForgotPassword" asp-controller="Account">
                @Html.AntiForgeryToken()

                <div class="input-group-custom">
                    <label>E-posta Adresi</label>
                    <input type="email" name="email" placeholder="ornek@gmail.com" required />
                </div>

                <button type="submit" class="login-submit mt-3">
                    Sıfırlama Linki Gönder <span>→</span>
                </button>

                <div class="text-center mt-3">
                    <a asp-action="Login" asp-controller="Account"
                           style="font-size:0.85rem; color:#6b7280; text-decoration:none;">
                        ← Giriş sayfasına dön
                    </a>
                </div>
            </form>

        </div>
    </div>
</div>
