@{
    Layout = "_LoginLayout";
}
<link href="~/css/LoginPanel.css" rel="stylesheet" />

<div class="login-wrapper">

    <!-- Sol panel — dekoratif -->
    <div class="login-left">
        <div class="login-left-content">
            <div class="login-left-content">
                <h2>Kütüphane<br />Yönetim Sistemi</h2>
                <p>Kurumsal kütüphane operasyonlarınızı<br />tek platformdan yönetin</p>
                <div class="login-divider"></div>
                <p class="login-version">v1.0.0 — Kurumsal Panel</p>
            </div>
        </div>
    </div>

    <!-- Sağ panel — form -->
    <div class="login-right">
        <div class="login-form-box">

            <h3 class="login-heading">Hoş Geldiniz</h3>
            <p class="login-sub">Devam etmek için giriş yapın</p>

            @if (ViewBag.Error != null)
            {
                <div class="login-error">
                    <span>⚠️</span> @ViewBag.Error
                </div>
            }
            @if (TempData["Success"] != null)
            {
                <div style="background:#f0fdf4; border:1px solid #bbf7d0; color:#16a34a;
                    border-radius:10px; padding:10px 14px; font-size:0.85rem; margin-bottom:20px;">
                    ✅ @TempData["Success"]
                </div>
            }


            <form method="post" asp-action="Login" asp-controller="Account">

                <div class="input-group-custom">
                    <label>E-posta</label>
                    <input type="email" name="Email" placeholder="ornek@gmail.com" required />
                </div>

                <div class="input-group-custom">
                    <label>Şifre</label>
                    <input type="password" name="Password" placeholder="••••••••" required />
                </div>

                <div class="login-options">
                    <a  asp-action="ForgotPassword" asp-controller="Account" class="forgot-link">Şifremi unuttum</a>
                </div>

                <button type="submit" class="login-submit">
                    Giriş Yap <span>→</span>
                </button>

            </form>

        </div>
    </div>

</div>
